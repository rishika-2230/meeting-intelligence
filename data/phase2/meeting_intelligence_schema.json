{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeetingIntelligenceExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meeting_id",
    "summary",
    "decisions",
    "commitments",
    "action_items",
    "objections",
    "risks",
    "unanswered_questions",
    "overall_confidence",
    "requires_human_review"
  ],
  "properties": {
    "meeting_id": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence_turn_ids",
        "confidence"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "evidence_turn_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "commitments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commitment"
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "objections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "unanswered_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_human_review": {
      "type": "boolean"
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "owner",
        "evidence_turn_ids",
        "confidence"
      ],
      "properties": {
        "decision": {
          "type": "string"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_turn_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitment",
        "owner",
        "deadline",
        "evidence_turn_ids",
        "confidence"
      ],
      "properties": {
        "commitment": {
          "type": "string"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_turn_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "owner",
        "deadline",
        "status",
        "evidence_turn_ids",
        "confidence"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "completed",
            "unclear"
          ]
        },
        "evidence_turn_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "raised_by",
        "evidence_turn_ids",
        "confidence"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "raised_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_turn_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "raised_by",
        "evidence_turn_ids",
        "confidence"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "raised_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_turn_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}